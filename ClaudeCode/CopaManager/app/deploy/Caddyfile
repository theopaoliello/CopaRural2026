# Caddyfile do Copa Manager — instale em /etc/caddy/Caddyfile.
# O Caddy emite e renova o certificado HTTPS sozinho (Let's Encrypt), desde
# que o dominio aponte para esta VM e as portas 80/443 estejam abertas.

copamanager.com.br {
	encode gzip zstd

	# Todo o trafego vai para o Node (a app serve estaticos, /uploads e a API).
	reverse_proxy localhost:3000

	# Log de acesso (util para diagnostico; rotaciona sozinho).
	log {
		output file /var/log/caddy/copamanager.log
	}
}

# Opcional: redirecionar o www para o dominio raiz.
# www.copamanager.com.br {
# 	redir https://copamanager.com.br{uri} permanent
# }
