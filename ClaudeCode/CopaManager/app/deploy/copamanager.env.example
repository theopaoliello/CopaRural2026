# Copie para /etc/copamanager.env e ajuste. Lido pelo servico systemd.

# Porta interna onde o Node escuta (o Caddy faz o proxy do 443 para ca).
PORTA=3000

# Producao em HTTPS: cookie de sessao ganha a flag Secure e o servidor
# passa a enviar HSTS. Deixe 1 sempre que houver HTTPS na frente (Caddy).
COOKIE_SEGURO=1

# Atras do Caddy (reverse proxy): faz o Express ler o IP real do visitante
# no X-Forwarded-For. Sem isso, o rate limit do login veria todo mundo
# como um IP so (o do proxy). 1 = confia em um proxy.
CONFIA_PROXY=1

# URL publica do site: base dos links enviados por e-mail (confirmacao) e do
# redirect do login com Google. Obrigatoria em producao.
URL_PUBLICA=https://copamanager.com.br

# --- E-mail transacional (confirmacao de cadastro) via Brevo ---
# Crie a conta gratis em https://www.brevo.com (300 e-mails/dia), gere a chave
# em Settings > SMTP & API > API Keys. SEM a chave o app roda em "modo log":
# o link de confirmacao sai no journalctl em vez de ser enviado.
#BREVO_API_KEY=xkeysib-...
# Remetente exibido nos e-mails. Valide o dominio copamanager.com.br no Brevo
# (Senders & Domains) para nao cair em spam.
#EMAIL_REMETENTE=nao-responda@copamanager.com.br

# --- Login com Google (SSO) ---
# Crie em https://console.cloud.google.com > APIs & Services > Credentials >
# Create OAuth client ID (tipo Web application) com:
#   Authorized redirect URI: https://copamanager.com.br/api/auth/google/callback
# Sem as duas variaveis o botao "Entrar com Google" nem aparece no site.
#GOOGLE_CLIENT_ID=....apps.googleusercontent.com
#GOOGLE_CLIENT_SECRET=GOCSPX-...
