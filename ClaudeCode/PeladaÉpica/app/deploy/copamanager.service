[Unit]
# Servico systemd do Copa Manager. Instale em /etc/systemd/system/.
Description=Copa Manager (Node/Express)
After=network.target

[Service]
Type=simple
User=copamanager
Group=copamanager
WorkingDirectory=/opt/copamanager
# Variaveis de ambiente (PORTA, COOKIE_SEGURO, CONFIA_PROXY). O "-" torna o
# arquivo opcional: o servico sobe mesmo se ele nao existir ainda.
EnvironmentFile=-/etc/copamanager.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3

# Reforco de isolamento: o processo so pode escrever no proprio diretorio.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/copamanager/data /opt/copamanager/uploads

[Install]
WantedBy=multi-user.target
