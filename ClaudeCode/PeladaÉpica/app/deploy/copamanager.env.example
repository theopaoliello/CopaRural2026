# Copie para /etc/copamanager.env e ajuste. Lido pelo servico systemd.

# Porta interna onde o Node escuta (o Caddy faz o proxy do 443 para ca).
PORTA=3000

# Producao em HTTPS: cookie de sessao ganha a flag Secure e o servidor
# passa a enviar HSTS. Deixe 1 sempre que houver HTTPS na frente (Caddy).
COOKIE_SEGURO=1

# Atras do Caddy (reverse proxy): faz o Express ler o IP real do visitante
# no X-Forwarded-For. Sem isso, o rate limit do login veria todo mundo
# como um IP so (o do proxy). 1 = confia em um proxy.
CONFIA_PROXY=1
