[Unit]
# Servico systemd do Pelada Epica. Instale em /etc/systemd/system/.
Description=Pelada Epica (Node/Express)
After=network.target

[Service]
Type=simple
User=pelada
Group=pelada
WorkingDirectory=/opt/pelada-epica
# Variaveis de ambiente (PORTA, COOKIE_SEGURO, CONFIA_PROXY). O "-" torna o
# arquivo opcional: o servico sobe mesmo se ele nao existir ainda.
EnvironmentFile=-/etc/pelada-epica.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3

# Reforco de isolamento: o processo so pode escrever no proprio diretorio.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/pelada-epica/data /opt/pelada-epica/uploads

[Install]
WantedBy=multi-user.target
